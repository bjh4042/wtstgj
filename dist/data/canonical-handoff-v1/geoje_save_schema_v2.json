  "meta": {
    "project": "거제몬스터",
    "file_name": "geoje_save_schema_v2.json",
    "version": "v2_2026-09-17",
    "created": "2026-09-17",
    "storage_policy": "browser_local_only_plus_manual_gem_export_import",
    "firebase_required_for_single_save": false,
    "source_of_truth": {
      "manifest": "geoje_final_source_manifest_v1.json",
      "flags": "geoje_story_flags_master_v2.json",
      "battle": "geoje_battle_collection_master_v3.json",
      "character": "geoje_character_npc_master_v2.json"
    },
    "status": "STATIC_VALIDATION_PASS"
  },
  "container_policy": {
    "user_slot_count": 3,
    "slot_ids": [
      1,
      2,
      3
    ],
    "per_slot_snapshots": [
      "primary",
      "lastKnownGood"
    ],
    "logical_keys": {
      "slot_1_primary": "geojeMonster.save.v2.slot1.primary",
      "slot_1_lkg": "geojeMonster.save.v2.slot1.lastKnownGood",
      "slot_2_primary": "geojeMonster.save.v2.slot2.primary",
      "slot_2_lkg": "geojeMonster.save.v2.slot2.lastKnownGood",
      "slot_3_primary": "geojeMonster.save.v2.slot3.primary",
      "slot_3_lkg": "geojeMonster.save.v2.slot3.lastKnownGood"
    },
    "write_strategy": [
      "1. 새 snapshot을 temporary record에 완전히 기록",
      "2. schema/invariant/checksum 검증",
      "3. 기존 primary를 lastKnownGood로 이동",
      "4. 검증된 temporary를 primary로 승격",
      "5. 성공 후 temporary 삭제"
    ],
    "recovery": "primary 검증 실패 시 lastKnownGood를 사용자에게 복구 후보로 제시. lastKnownGood를 자동 덮어쓰지 않는다.",
    "manual_save": true,
    "autosave": true,
    "cloud_sync": false,
    "autosave_triggers": [
      "맵 전환",
      "체육관/라이벌/스토리 보스전 승리",
      "생태몬 포획·연구동행·NPC교환",
      "중요도구 또는 일회성 보상 획득",
      "랜드마크 퍼즐 완료",
      "흑망단 포획선 구역 체크포인트",
      "사천왕 각 승리 및 챔피언 승리",
      "POST 전설 포획/나침반 완성"
    ]
  },
  "storage_capacity": {
    "party_max": 6,
    "pc_total_capacity": 300,
    "pc_box_count": 10,
    "pc_box_capacity": 30,
    "box_ids": [
      "BOX01",
      "BOX02",
      "BOX03",
      "BOX04",
      "BOX05",
      "BOX06",
      "BOX07",
      "BOX08",
      "BOX09",
      "BOX10"
    ],
    "full_behavior": "파티 6 + PC 300이 모두 찬 경우 포획 아이템을 소비하기 전에 포획 시도를 차단하고 빈 공간이 필요하다고 안내",
    "release_policy": {
      "supported": true,
      "two_step_confirmation": true,
      "instance_field": "releaseProtected",
      "rule": "releaseProtected=true 개체는 자연으로 돌려보내기 불가. 어떤 획득 경로가 보호 대상인지는 Acquisition/Story 구현에서 부여한다."
    }
  },
