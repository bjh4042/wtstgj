    "activatedSpeciesNos_rule": "authoritative union of acquired/registered collection states; on migration derive as union(caughtSpeciesNos, researchRegisteredSpeciesNos, speciesNo of all creature instances)",
    "badgeTraits_rule": "recompute from BADGE_01..BADGE_08 and Story Flags v2 badge_trait_bindings on every load",
    "fullExplorationCertificate_eligibility": "MAIN_STORY_CLEAR && activatedSpeciesNos.length == 151"
  },
  "name_validation_contract": {
    "applies_to": [
      "new_game_player_name",
      "creature_nickname",
      "gem_import_player_name",
      "gem_import_creature_nickname",
      "certificate_render"
    ],
    "normalization": [
      "Unicode NFC",
      "trim leading/trailing whitespace",
      "reject control/invisible characters"
    ],
    "forbidden_word_engine": [
      "exact block",
      "normalized block",
      "consonant abbreviation",
      "reserved names",
      "whitelist override"
    ],
    "ruleset_content": "external shared name-filter dataset; Save v2 does not invent the banned-word list",
    "import_behavior": "every .gem import revalidates names; invalid name blocks import until user chooses a valid replacement or cancels"
  },
  "playtime_contract": {
    "field": "profile.foregroundPlayTimeSeconds",
    "increment_when": "app/game document is foreground-visible and save slot is actively loaded",
    "pause_when": [
      "browser tab hidden",
      "app backgrounded",
      "slot not loaded"
    ],
    "note": "background suspension time is excluded; normal in-game menus may remain counted"
  },
  "champion_snapshot_contract": {
    "trigger": "MAIN_STORY_CLEAR transitions false→true at FINAL_CHAMPION",
    "write_once": true,
    "immutable_after_first_write": true,
    "used_for": [
      "ending certificate",
      "first clear archive"
    ],
    "postgame_rematches_do_not_overwrite": true
